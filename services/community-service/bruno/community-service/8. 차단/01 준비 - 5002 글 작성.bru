meta {
  name: 준비: 5002 글 작성
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/community-service/posts
  body: json
  auth: none
}

headers {
  X-User: {{residentId2}}
}

body:json {
  {
    "category": "SHARE",
    "title": "화분 나눔해요",
    "content": "작은 화분 3개 나눔합니다"
  }
}

script:post-response {
  if (res.status === 201) bru.setEnvVar("otherPostId", res.body.postId);
}
