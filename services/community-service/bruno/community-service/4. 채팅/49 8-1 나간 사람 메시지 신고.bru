meta {
  name: 49 8-1 나간 사람 메시지 신고
  type: http
  seq: 49
}

post {
  url: {{baseUrl}}/community-service/reports
  body: json
  auth: none
}

headers {
  X-User: {{residentId}}
}

body:json {
  {
    "sourceType": "CHAT_ROOM",
    "sourceId": {{roomId}},
    "targetType": "CHAT_MESSAGE",
    "targetId": "{{partnerMessageId}}",
    "reasonType": "HARASSMENT",
    "reasonDetail": "말만 하고 나가버렸어요."
  }
}
