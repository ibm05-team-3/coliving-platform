meta {
  name: 35 8-1 내 메시지 신고 (403)
  type: http
  seq: 35
}

post {
  url: {{baseUrl}}/community-service/reports
  body: json
  auth: none
}

headers {
  X-User: {{residentId}}
}

body:json {
  {
    "sourceType": "CHAT_ROOM",
    "sourceId": {{roomId}},
    "targetType": "CHAT_MESSAGE",
    "targetId": "{{myMessageId}}",
    "reasonType": "SPAM"
  }
}
