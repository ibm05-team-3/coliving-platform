meta {
  name: 4-6 5002 답장 201 (messageId 저장)
  type: http
  seq: 10
}

post {
  url: {{baseUrl}}/community-service/chat/rooms/{{roomId}}/messages
  body: json
  auth: none
}

headers {
  X-User: {{residentId2}}
}

body:json {
  {
    "content": "10시에 1층 라운지 어때요?"
  }
}

script:post-response {
  if (res.status === 201) bru.setEnvVar("messageId", res.body.messageId);
}
