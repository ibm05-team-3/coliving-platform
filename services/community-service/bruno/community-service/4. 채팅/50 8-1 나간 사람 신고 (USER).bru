meta {
  name: 50 8-1 나간 사람 신고 (USER)
  type: http
  seq: 50
}

post {
  url: {{baseUrl}}/community-service/reports
  body: json
  auth: none
}

headers {
  X-User: {{residentId}}
}

body:json {
  {
    "sourceType": "CHAT_ROOM",
    "sourceId": {{roomId}},
    "targetType": "USER",
    "targetId": "{{residentId2}}",
    "reasonType": "HARASSMENT"
  }
}
