meta {
  name: 08 4-6 5001 보내기
  type: http
  seq: 8
}

post {
  url: {{baseUrl}}/community-service/chat/rooms/{{roomId}}/messages
  body: json
  auth: none
}

headers {
  X-User: {{residentId}}
}

body:json {
  {
    "content": "안녕하세요! 장 보러 같이 가요."
  }
}

script:post-response {
  if (res.status === 201) bru.setEnvVar("myMessageId", res.body.messageId);
}
