meta {
  name: 02 4-2 채팅방 열기
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/community-service/chat/rooms
  body: json
  auth: none
}

headers {
  X-User: {{residentId}}
}

body:json {
  {
    "partnerUserId": {{residentId2}},
    "sourceType": "POST",
    "sourcePostId": {{otherPostId}}
  }
}

script:post-response {
  if (res.status === 200 || res.status === 201) bru.setEnvVar("roomId", res.body.roomId);
}
