meta {
  name: 36 8-1 참여자 아닌 사람이 신고 (404)
  type: http
  seq: 36
}

post {
  url: {{baseUrl}}/community-service/reports
  body: json
  auth: none
}

headers {
  X-User: {{residentId3}}
}

body:json {
  {
    "sourceType": "CHAT_ROOM",
    "sourceId": {{roomId}},
    "targetType": "CHAT_MESSAGE",
    "targetId": "{{messageId}}",
    "reasonType": "ABUSE"
  }
}
