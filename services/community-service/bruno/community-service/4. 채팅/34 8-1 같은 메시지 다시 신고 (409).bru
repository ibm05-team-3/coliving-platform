meta {
  name: 34 8-1 같은 메시지 다시 신고 (409)
  type: http
  seq: 34
}

post {
  url: {{baseUrl}}/community-service/reports
  body: json
  auth: none
}

headers {
  X-User: {{residentId}}
}

body:json {
  {
    "sourceType": "CHAT_ROOM",
    "sourceId": {{roomId}},
    "targetType": "CHAT_MESSAGE",
    "targetId": "{{messageId}}",
    "reasonType": "ABUSE"
  }
}
