meta {
  name: 6-1 알림 목록 (5001)
  type: http
  seq: 5
}

get {
  url: {{baseUrl}}/community-service/notifications?page=0&size=20
  body: none
  auth: none
}

headers {
  X-User: {{residentId}}
}

script:post-response {
  const list = res.body.content || [];
  if (list.length > 0) bru.setEnvVar("notificationId", list[0].notificationId);
}
