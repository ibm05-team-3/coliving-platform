meta {
  name: 9-3 이용 제한 7일 + 댓글 숨김 200
  type: http
  seq: 13
}

post {
  url: {{baseUrl}}/community-service/admin/reports/{{reportId}}/actions
  body: json
  auth: none
}

headers {
  X-User: {{adminId}}
}

body:json {
  {
    "action": "RESTRICTION",
    "durationDays": 7,
    "hideContent": true,
    "reason": "게시판 비하 발언",
    "adminMemo": "신고 2건"
  }
}

script:post-response {
  if (res.status === 200) bru.setEnvVar("sanctionId", res.body.sanctionId);
}
